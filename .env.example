# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/socircle

# Authentication
JWT_SECRET=your-jwt-secret-key-here
SESSION_SECRET=your-session-secret-key-here

# Email Service (SendGrid, Mailgun, Resend, etc.)
EMAIL_SERVICE_API_KEY=your-email-service-api-key
EMAIL_FROM_ADDRESS=noreply@socirclenetwork.com
EMAIL_TO_ADDRESS=contact@socirclenetwork.com

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Application
NODE_ENV=production
BASE_URL=https://socirclenetwork.com
